{
  "name": "myprose",
  "version": "3.2.7",
  "description": "myProse is an environment for structuring writing tasks with the help of generative artificial intelligence and other natural language analysis tools.",
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#assets/*": "./assets/*",
    "#components/*": "./components/*",
    "#layouts/*": "./layouts/*",
    "#lib/*": "./src/lib/*",
    "#pages/*": "./pages/*",
    "#server/*": "./src/server/*"
  },
  "private": true,
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "test": "npx bun test",
    "test:watch": "npx bun test --watch",
    "test:vitest": "vitest",
    "preview": "cross-env NODE_ENV=production npm run build && cross-env NODE_ENV=production node ./dist/server/index.mjs",
    "start": "npm run preview",
    "check_format": "prettier -c src/ pages/ components/ layouts/ +server.ts",
    "lint": "eslint src pages components layouts +server.ts",
    "format": "prettier --write src/ pages/ components/ layouts/ +server.ts .storybook/",
    "depcheck": "npx knip",
    "precommit": "npm run check_format && npm run lint && npm run test && npm run gen:schema",
    "gen:schema": "npx typescript-json-schema ./tsconfig.gen.json WritingTask --out ./src/lib/WritingTask.schema.json",
    "storybook": "storybook dev -p 6006",
    "upgrade-storybook": "npx storybook@latest upgrade",
    "build-storybook": "storybook build",
    "postinstall": "patch-package",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CMUEberlyCenter/eberly-docuscope-wa.git",
    "directory": "frontend"
  },
  "keywords": [
    "docuscope",
    "ontopic",
    "cmu",
    "Carnegie Mellon University",
    "english",
    "writing"
  ],
  "author": "Michael Ringenberg <Ringenberg@users.noreply.github.com> (https://www.andrew.cmu.edu/user/mringenb/)",
  "contributors": [],
  "license": "CC-BY-NC-4.0",
  "bugs": {
    "url": "https://github.com/CMUEberlyCenter/eberly-docuscope-wa/issues"
  },
  "homepage": "https://www.cmu.edu/dietrich/english/research-and-publications/myprose.html",
  "browserslist": [
    "defaults"
  ],
